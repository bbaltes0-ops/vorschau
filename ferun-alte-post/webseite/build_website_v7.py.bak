def raumwahl(seite):
    """Elegante Auswahl der Raeume am Seitenende: 3er-Raster, gleich breite Felder, aktueller Raum markiert."""
    zellen = ""
    for s, n, spr, satz, _kb, _k, nr, was in BEREICHE:
        hier = s == seite
        zellen += (f'<a href="{s}.html"{" aria-current=\"page\"" if hier else ""}><span class="n">{n}</span>'
                   f'<span class="w">{"Hier seid Ihr gerade" if hier else was}</span></a>')
    idx = [b[0] for b in BEREICHE].index(seite) if seite in B else -1
    nxt = BEREICHE[(idx + 1) % 6]
    weiter = f'<a class="mehr caps" href="{nxt[0]}.html">Weiter: {nxt[1]}</a>' if idx >= 0 else ""
    cur = lambda x: ' aria-current="page"' if x == seite else ""
    return f"""<section class="raumwahl-band"><div class="wrap">
  <div class="raumwahl-kopf"><h2>Das Haus entdecken</h2>{weiter}</div>
  <nav class="raumwahl" aria-label="Räume">{zellen}</nav>
</div></section>"""


def bereichswahl(seite):
    cur = lambda s: ' aria-current="page"' if s == seite else ""
    return '<nav class="bereichswahl caps" aria-label="Bereiche">' + "".join(
        f'<a href="{s}.html"{cur(s)}>{n}</a>' for s, n, *_ in BEREICHE) + f'<a href="karte.html"{cur("karte")}>Karte</a></nav>'


def seitenkopf(eyebrow, titel, sub, slot=None, bildname=None, alt=""):
    b = bild(slot, bildname, ar="21/9", alt=alt, lazy=False) if bildname else ""
    return f"""<section class="seitenkopf"><div class="wrap">
  <div class="titel"><div><span class="caps eyebrow">{eyebrow}</span><h1>{titel}</h1></div><p class="lead fade">{sub}</p></div>
  {b}</div></section>"""


def bereichsseite_bogen(v, s):
    _, n, spr, satz, _kb, kopfbild, nr, was = B[s]
    lead, text, punkte, _drei, cta = SEITEN[s]
    pk = "".join(f"<li><b>{a}</b><span>{b}</span></li>" for a, b in punkte)
    liste = f'<ul class="punkte fade d2">{pk}</ul>' if punkte else ""
    if s == "festsaal":
        liste = """<ol class="ablauf fade d2" style="grid-template-columns:1fr 1fr;max-width:520px">
      <li><b>Anfrage</b><p>Anlass, Datum, Gäste</p></li><li><b>Gespräch</b><p>wir rufen an</p></li>
      <li><b>Vorschlag</b><p>Menü und Ablauf</p></li><li><b>Das Fest</b><p>Ihr feiert</p></li></ol>"""
    teile = [f"""<section class="kopf3">{SCHATTEN}<div class="wrap raster">
  <div><span class="caps eyebrow">{n}</span><h1>{spr}</h1><p class="lead fade">{lead}</p><p class="fade d1">{text}</p>{liste}
    <div class="fade d3" style="margin-top:26px;display:flex;gap:14px 24px;flex-wrap:wrap;align-items:center"><a class="knopf voll" href="{cta[1]}">{cta[0]}</a></div></div>
  {bild("kopf", kopfbild, ar=None, cls="bogen", alt=n, lazy=False)}
</div></section>"""]
    teile.append(galerie("galerie", GALERIEN[s], "Einblicke", was + "."))
    if s == "festsaal":
        teile.append(festsaal_form())
    teile.append(raumwahl(s))
    return seite(v, s, f"{n} · FERUN Alte Post Eggstätt", f"{n} im FERUN Alte Post am Kirchplatz in Eggstätt: {satz}", "\n".join(teile))



# ---------------------------------------------------------------- Klare Fassung (klar + salbei)

KACHEL_KLAR = {"gasthaus": "R2C_A08_gedeck", "vinothek": "R4G_M04_4x5", "biergarten": "R2C_G06_aussen",
               "greisslerei": "WC_W36_1x1", "bar": "R3C_C33_4x5", "festsaal": "R2G_C04_raeume"}
KACHEL_PX = {"biergarten": 0}          # Ausschnitt-Vorgabe (Prozent von links), per Editor aenderbar
# Zweites Bild beim Darueberfahren (Maus) – zeigt eine andere Seite des Raums
KACHEL_ZWEIT = {"gasthaus": "WC_W47_9x16", "vinothek": "R3C_C34_4x5", "biergarten": "R3C_C31_4x5",
                "greisslerei": "R3G_G23_4x5", "bar": "R1G_E05_getraenke", "festsaal": "R2G_B16_essen"}
KOPF_KLAR = {"gasthaus": "R4G_M01_16x9", "vinothek": "R4C_N04_16x9", "biergarten": "R2C_E02_getraenke",
             "greisslerei": "WC_W19_21x9", "bar": "WC_W26_3x2", "festsaal": "R2C_B16_essen"}


def startseite(v):
    if v == "bogen":
        return startseite_bogen(v)
    if v == "linie":
        return startseite_linie(v)
    hero = f"""<section class="hero-foto" aria-label="Willkommen">
  {bild("hero", "WC_W01_16x9", ar=None, cls="foto", alt="Die Tafelstube im Morgenlicht", lazy=False, fest=True)}
  <div class="hero-foto-inhalt">
    <img class="hero-logo" src="../assets/logo/FERUN_01_Hoch_Blatt_Eggstaett_weiss.svg" alt="FERUN Alte Post Eggstätt">
    <h1>Alpenländische Küche am Kirchplatz.</h1>
    <div class="aktionen"><a class="knopf hell voll" href="kontakt.html" data-res>Tisch reservieren</a><a class="knopf hell" href="karte.html">Wochenkarte</a></div>
  </div></section>"""
    will = """<section class="sektion willkommen3"><div class="wrap">
  <h2 class="fade">Grüß Gott am Kirchplatz.</h2>
  <p class="lead fade d1">Ein neues Gasthaus zieht in ein altes, historisches Haus. Wir kochen alpenländisch, mit guten Zutaten aus der Region – dazu gibt es eine Vinothek, einen Biergarten, eine Greißlerei, eine Bar und einen Festsaal.</p>
</div></section>"""
    k = "".join(f"""<a class="kachel fade d{i % 3}" href="{s}.html"><div class="kachel-bild">{bild("kachel-" + s, KACHEL_KLAR[s], alt=n, lazy=False, px=KACHEL_PX.get(s))}
    <img class="zweit" src="{f(KACHEL_ZWEIT[s])}" alt="" loading="lazy" decoding="async"><span class="spruch" aria-hidden="true">{spr}</span></div>
    <div class="unter"><h3>{n}</h3><p>{was}</p></div></a>""" for i, (s, n, spr, _, kb, _k, nr, was) in enumerate(BEREICHE))
    kach = f"""<section class="sektion kacheln-band linie-oben" aria-labelledby="k-titel"><div class="wrap">
  <div class="kopfzeile"><h2 id="k-titel" class="fade">Sechs Räume, ein Haus.</h2></div>
  <div class="kacheln">{k}</div></div></section>"""
    return seite(v, "index", "FERUN Alte Post · Gasthaus am Kirchplatz in Eggstätt",
                 "FERUN Alte Post: ein neues Gasthaus am Kirchplatz in Eggstätt mit alpenländischer Küche, Vinothek, Biergarten, Greißlerei, Bar und Festsaal.",
                 hero + will + kach + galerie("einblicke", EINBLICKE, "Einblicke", "Ein paar Blicke ins Haus, auf den Tisch und hinter die Theke.", bogen=False) + aufruf())


def bereichsseite(v, s):
    if v == "bogen":
        return bereichsseite_bogen(v, s)
    if v == "linie":
        return bereichsseite_linie(v, s)
    _, n, spr, satz, _kb, _kopf, nr, was = B[s]
    lead, text, punkte, _drei, cta = SEITEN[s]
    pk = "".join(f"<li><b>{a}</b><span>{b}</span></li>" for a, b in punkte)
    rechts = f'<ul class="punkte fade d1">{pk}</ul>' if punkte else ""
    if s == "festsaal":
        rechts = """<ol class="ablauf fade d1" style="grid-template-columns:1fr 1fr">
      <li><b>Anfrage</b><p>Anlass, Datum, Gäste</p></li><li><b>Gespräch</b><p>wir rufen an</p></li>
      <li><b>Vorschlag</b><p>Menü und Ablauf</p></li><li><b>Das Fest</b><p>Ihr feiert</p></li></ol>"""
    teile = [seitenkopf(n, spr, satz, "kopf", KOPF_KLAR[s], n),
             f"""<section class="sektion"><div class="wrap inhalt2">
  <div class="fade"><p class="lead">{lead}</p><p>{text}</p><a class="knopf voll" href="{cta[1]}">{cta[0]}</a></div>
  <div>{rechts}</div></div></section>""",
             galerie("galerie", GALERIEN[s], "Einblicke", was + ".", bogen=False)]
    if s == "festsaal":
        teile.append(festsaal_form())
    nxt = BEREICHE[([b[0] for b in BEREICHE].index(s) + 1) % 6]
    teile.append(raumwahl(s))
    return seite(v, s, f"{n} · FERUN Alte Post Eggstätt", f"{n} im FERUN Alte Post am Kirchplatz in Eggstätt: {satz}", "\n".join(teile))



# ---------------------------------------------------------------- Variante "Linie" (minimalistisch, kunstvoll)

BLATT = '<img class="l-blatt" src="../assets/logo/FERUN_08_Signet_Blatt_kupfer.svg" alt="" aria-hidden="true">'


def kopf_linie(seite):
    cur = lambda s: ' aria-current="page"' if s == seite else ""
    links = "".join(f'<a class="caps" href="{s}.html"{cur(s)}>{n}</a>' for s, n, *_ in BEREICHE[:3])
    rechts = "".join(f'<a class="caps" href="{s}.html"{cur(s)}>{n}</a>' for s, n, *_ in BEREICHE[3:])
    vm = "".join(f'<a href="{s}.html">{n}</a>' for s, n, *_ in BEREICHE)
    return f"""<header class="kopf l-kopf"><div class="wrap">
  <div class="l-zeile caps"><a href="karte.html"{cur("karte")}>Wochenkarte</a><a href="haus.html"{cur("haus")}>Das Haus</a>
    <a class="l-res" href="kontakt.html" data-res>Tisch reservieren</a></div>
  <div class="l-mitte"><nav class="l-nav l-links" aria-label="Bereiche">{links}</nav>
    <a class="logo-link" href="index.html" aria-label="FERUN Alte Post – Startseite"><img src="../assets/logo/FERUN_04_Quer_Blatt_farbig.svg" alt="FERUN Alte Post"></a>
    <nav class="l-nav l-rechts" aria-label="Weitere Bereiche">{rechts}</nav>
    <button class="menue-knopf caps" type="button" aria-expanded="false" aria-controls="vollmenue">Menü</button></div>
</div></header>
<div class="vollmenue" id="vollmenue" aria-label="Menü"><button class="menue-zu caps" type="button">Schließen</button>
  <nav><a href="index.html">Startseite</a>{vm}<div class="unten"><a href="karte.html">Wochenkarte</a><a href="haus.html">Das Haus</a><a href="kontakt.html" data-res>Tisch reservieren</a><a href="tel:{TEL}">{TEL_TXT}</a></div></nav></div>"""


def figur_linie(slot, name, text, ar="16/9", lazy=True, fest=False):
    return f'<figure class="l-fig">{bild(slot, name, ar=ar, alt=text, lazy=lazy, fest=fest)}<figcaption>{text}</figcaption></figure>'


def verzeichnis(mit_bildern=True):
    zeilen = "".join(f"""<li><a href="{s}.html" data-i="{i}"><span class="l-name">{n}</span><span class="l-spr">{spr}</span></a>
      <span class="l-was">{was}</span></li>""" for i, (s, n, spr, _, kb, _k, nr, was) in enumerate(BEREICHE))
    rahmen = ""
    if mit_bildern:
        rahmen = '<div class="l-rahmen">' + "".join(
            f'<div class="l-rbild{" an" if i == 0 else ""}" data-i="{i}">{bild("raum-" + s, KACHEL_KLAR[s], ar=None, alt=n, lazy=False, fest=True, px=KACHEL_PX.get(s))}</div>'
            for i, (s, n, *_r) in enumerate(BEREICHE)) + '<p class="l-rtext"></p></div>'
    return f'<div class="l-verz"><ol class="l-liste">{zeilen}</ol>{rahmen}</div>'


def galerie_linie(slot, eintraege, titel, sub):
    items = "".join(f'<a class="l-g{fm}" href="{f(nm)}"><figure>{bild(f"{slot}-{i}", nm, ar=None, alt=txt, fest=True)}<figcaption>{txt}</figcaption></figure></a>'
                    for i, (nm, fm, bo, txt) in enumerate(eintraege))
    return f"""<section class="sektion l-sek"><div class="wrap">
  <div class="l-kopfzeile"><span class="caps">Einblicke</span><h2 class="fade">{titel}</h2><p class="fade d1">{sub}</p></div>
  <div class="galerie3 l-galerie">{items}</div></div></section>"""


def startseite_linie(v):
    hero = f"""<section class="l-hero"><div class="wrap">
  <figure class="l-haus"><img src="../assets/haus_zeichnung.png" alt="Zeichnung des Hauses am Kirchplatz in Eggstätt"></figure>
  <h1 class="fade">Alpenländische Küche am Kirchplatz.</h1>
  <p class="l-sub fade d1">Ein neues Gasthaus in einem alten, historischen Haus in Eggstätt.</p>
  <div class="l-aktionen fade d2"><a class="caps" href="kontakt.html" data-res>Tisch reservieren</a>{BLATT}<a class="caps" href="karte.html">Wochenkarte</a></div>
</div></section>
<section class="l-bildband"><div class="wrap">{figur_linie("hero", "WC_W01_16x9", "Die Tafelstube am Morgen", ar="21/9", lazy=False)}</div></section>"""
    will = f"""<section class="sektion l-sek"><div class="wrap l-zwei">
  <div class="l-kopfzeile"><span class="caps">Willkommen</span><h2 class="fade">Grüß Gott am Kirchplatz.</h2></div>
  <div class="fade d1"><p class="lead">Ein neues Gasthaus zieht in ein altes, historisches Haus.</p>
  <p>Wir kochen alpenländisch, mit guten Zutaten aus der Region und viel Handwerk. Dazu gibt es eine Vinothek, einen Biergarten, eine Greißlerei, eine Bar und einen Festsaal – und für jeden ein Tischerl.</p></div>
</div></section>"""
    raeume = f"""<section class="sektion l-sek"><div class="wrap">
  <div class="l-kopfzeile"><span class="caps">Die Räume</span><h2 class="fade">Sechs Räume, ein Haus.</h2></div>
  {verzeichnis()}</div></section>"""
    schluss = f"""<section class="sektion l-schluss"><div class="wrap">{BLATT}
  <h2 class="fade">Damit auch ein Tischerl frei ist.</h2>
  <div class="l-aktionen fade d1"><a class="caps" href="kontakt.html" data-res>Tisch reservieren</a><span class="l-punkt">·</span><a class="caps" href="tel:{TEL}">{TEL_TXT}</a></div>
  <p class="klein fade d2">Kirchplatz 2 · 83125 Eggstätt · Öffnungszeiten folgen</p></div></section>"""
    return seite(v, "index", "FERUN Alte Post · Gasthaus am Kirchplatz in Eggstätt",
                 "FERUN Alte Post: ein neues Gasthaus am Kirchplatz in Eggstätt mit alpenländischer Küche, Vinothek, Biergarten, Greißlerei, Bar und Festsaal.",
                 hero + will + raeume + galerie_linie("einblicke", EINBLICKE[:6], "Aus dem Haus.", "Ein paar Blicke ins Haus, auf den Tisch und hinter die Theke.") + schluss)


def bereichsseite_linie(v, s):
    _, n, spr, satz, _kb, _kopf, nr, was = B[s]
    lead, text, punkte, _drei, cta = SEITEN[s]
    if s == "festsaal":
        punkte = [("Anfrage", "Anlass, Datum, Gäste"), ("Gespräch", "wir rufen an"), ("Vorschlag", "Menü und Ablauf"), ("Das Fest", "Ihr feiert")]
    pk = "".join(f'<li><span class="l-name">{a}</span><span class="l-spr">{b}</span></li>' for a, b in punkte)
    teile = [f"""<section class="l-seitenkopf"><div class="wrap">
  <span class="caps">{n}</span><h1>{spr}</h1><p class="l-sub fade">{satz}</p>
  {figur_linie("kopf", KOPF_KLAR[s], n + " – " + was, ar="21/9", lazy=False)}</div></section>""",
             f"""<section class="sektion l-sek"><div class="wrap l-zwei">
  <div class="fade"><p class="lead">{lead}</p><p>{text}</p><a class="mehr caps" href="{cta[1]}"{" data-res" if "kontakt" in cta[1] and "reservieren" in cta[0] else ""}>{cta[0]}</a></div>
  <div class="fade d1"><span class="caps l-klein">Was Euch erwartet</span><ul class="l-liste l-punkte">{pk}</ul></div></div></section>""",
             galerie_linie("galerie", GALERIEN[s][:6], was + ".", "")]
    if s == "festsaal":
        teile.append(festsaal_form())
    teile.append(raumwahl(s))
    return seite(v, s, f"{n} · FERUN Alte Post Eggstätt", f"{n} im FERUN Alte Post am Kirchplatz in Eggstätt: {satz}", "\n".join(teile))


def festsaal_form():
    return f"""<section class="sektion linie-oben" id="anfrage"><div class="wrap inhalt2">
  <div><h2>Fest anfragen</h2><p style="margin-top:16px;color:var(--text-weich)">Wir melden uns schnell mit einem Vorschlag.</p></div>
  <form class="formular" data-mail="{MAIL}" data-betreff="Anfrage Festsaal" novalidate>
    <div class="feld"><label class="caps" for="fa-anlass">Anlass</label><select id="fa-anlass" name="anlass" data-label="Anlass"><option>Hochzeit</option><option>Taufe</option><option>Kommunion / Firmung</option><option>Geburtstag</option><option>Firmenfeier</option><option>Etwas anderes</option></select></div>
    <div class="feld"><label class="caps" for="fa-datum">Wunschdatum</label><input id="fa-datum" name="datum" type="date" data-label="Wunschdatum"></div>
    <div class="feld"><label class="caps" for="fa-gaeste">Gäste</label><input id="fa-gaeste" name="gaeste" inputmode="numeric" data-label="Gäste"></div>
    <div class="feld"><label class="caps" for="fa-name">Name</label><input id="fa-name" name="name" autocomplete="name" required data-label="Name"></div>
    <div class="feld voll"><label class="caps" for="fa-kontakt">Telefon oder E-Mail</label><input id="fa-kontakt" name="kontakt" autocomplete="email" required data-label="Kontakt"></div>
    <p class="klein fehler voll" hidden>Bitte Name und Telefon oder E-Mail angeben.</p>
    <div class="voll"><button class="knopf voll" type="submit">Anfrage senden</button></div>
    <p class="danke voll" hidden>Danke! Euer E-Mail-Programm öffnet sich mit der fertigen Anfrage.</p>
  </form></div></section>"""


# ---------------------------------------------------------------- Karte, Haus, Kontakt

GAENGE = [
    ("anfang", "Zum Anfang", [("Klare Rindssuppe mit Leberknödel", "Schnittlauch"), ("Rindertatar mit Preiselbeeren", "frischer Kren"), ("Eierschwammerl und Steinpilze", "auf Röstbrot")]),
    ("haupt", "Hauptgerichte", [("Kasnocken mit brauner Butter", "Bergkäse"), ("Saibling mit Rahmsauce", "Dill und Erdäpfel"), ("Rehrücken mit Spätzle", "Blaukraut"), ("Schweinsbraten mit Kruste", "Knödel")]),
    ("schluss", "Zum Schluss", [("Kaiserschmarrn mit Zwetschgenröster", "Puderzucker"), ("Apfelstrudel", "Vanillesauce"), ("Marillenknödel", "Butterbrösel")]),
    ("kinder", "Für die Kleinen", [("Kleiner Kaiserschmarrn", "Apfelmus"), ("Wiener Schnitzel vom Kalb", "Erdäpfelsalat")]),
]


def karte(v):
    nav = "".join(f'<a class="caps" href="#{i}">{t}</a>' for i, t, _ in GAENGE)
    gaenge = "".join(f'<div class="gang fade" id="{i}"><h2>{t}</h2><ul class="punkte">' +
                     "".join(f"<li><b>{g}</b><span>{x}</span></li>" for g, x in gs) + "</ul></div>" for i, t, gs in GAENGE)
    teile = [seitenkopf("Karte", "Die Wochenkarte.", "Jede Woche neu, nach Markt und Jahreszeit."),
             f'<nav class="kartennav" aria-label="Gänge"><div class="wrap">{nav}</div></nav>',
             f"""<section class="sektion"><div class="wrap"><p class="hinweis-box" style="margin-bottom:clamp(30px,4vw,54px)">Beispiel: So kann eine Woche bei uns schmecken. Die echte Karte mit Preisen gibt es hier zur Eröffnung.</p>
  <div class="gaenge">{gaenge}</div></div></section>""",
             raumwahl("karte")]
    return seite(v, "karte", "Wochenkarte · FERUN Alte Post Eggstätt", "Die Wochenkarte im FERUN Alte Post: alpenländische Küche nach Markt und Jahreszeit.", "\n".join(teile))


def haus(v):
    mat = [("R4G_M10_9x16", "Die Gewölbe"), ("R4G_M08_4x5", "Der Kachelofen"), ("R4G_M07_1x1", "Holz, Putz und Eiche")]
    teile = [seitenkopf("Das Haus", "Altes Haus, neues Leben.", "Ein neues Gasthaus zieht in ein altes, historisches Haus am Kirchplatz.", "kopf", "R4C_N10_16x9", "Raumfolge"),
             """<section class="sektion"><div class="wrap inhalt2">
  <p class="lead fade">Dicke Mauern, weiße Kreuzgewölbe, tiefe Fensternischen: Das Haus am Kirchplatz hat Charakter.</p>
  <p class="fade d1">Beim Umbau bleibt, was das Haus ausmacht. Dazu kommt, was ein Gasthaus heute braucht: Eichendielen, Salbeigrün, Messing, Terrazzo und grüne Kacheln. Alt und neu stehen ganz selbstverständlich nebeneinander.</p>
</div></section>""",
             '<section class="wrap" style="padding-bottom:clamp(48px,6vw,90px)"><div class="drei">' +
             "".join(f'<figure style="margin:0">{bild(f"material-{i}", b, alt=t)}<figcaption class="caps klein" style="margin-top:10px">{t}</figcaption></figure>' for i, (b, t) in enumerate(mat)) + "</div></section>",
             raumwahl("haus")]
    return seite(v, "haus", "Das Haus · FERUN Alte Post Eggstätt", "Ein neues Gasthaus zieht in ein altes, historisches Haus am Kirchplatz in Eggstätt.", "\n".join(teile))


def kontakt(v):
    teile = [seitenkopf("Reservieren &amp; Kontakt", "Ein Tischerl für Euch.", "Schreibt uns, wir melden uns mit einer Bestätigung."),
             f"""<section class="sektion" style="padding-top:0"><div class="wrap inhalt2">
  <div class="info fade">
    <div><h3>Adresse</h3><p>FERUN Alte Post<br>Kirchplatz 2 · 83125 Eggstätt</p></div>
    <div><h3>Öffnungszeiten</h3><p>Geben wir bekannt, sobald wir aufsperren.</p></div>
    <div><h3>Kontakt</h3><p><a href="tel:{TEL}">{TEL_TXT}</a><br><a href="mailto:{MAIL}">{MAIL}</a></p></div>
  </div>
  <form class="formular fade d1" data-mail="{MAIL}" data-betreff="Tischreservierung" novalidate>
    <div class="feld"><label class="caps" for="r-datum">Datum</label><input id="r-datum" name="datum" type="date" required data-label="Datum"></div>
    <div class="feld"><label class="caps" for="r-zeit">Uhrzeit</label><input id="r-zeit" name="zeit" type="time" data-label="Uhrzeit"></div>
    <div class="feld"><label class="caps" for="r-personen">Personen</label><select id="r-personen" name="personen" data-label="Personen">{"".join(f"<option>{i}</option>" for i in range(1, 11))}<option>mehr als 10</option></select></div>
    <div class="feld"><label class="caps" for="r-name">Name</label><input id="r-name" name="name" autocomplete="name" required data-label="Name"></div>
    <div class="feld voll"><label class="caps" for="r-kontakt">Telefon oder E-Mail</label><input id="r-kontakt" name="kontakt" autocomplete="email" required data-label="Kontakt"></div>
    <p class="klein fehler voll" hidden>Bitte Datum, Name und Telefon oder E-Mail angeben.</p>
    <div class="voll"><button class="knopf voll" type="submit">Anfrage senden</button></div>
    <p class="danke voll" hidden>Danke! Euer E-Mail-Programm öffnet sich mit der fertigen Anfrage.</p>
  </form></div></section>
<section class="sektion linie-oben" id="jobs"><div class="wrap inhalt2">
  <div><span class="caps eyebrow">Jobs</span><h2>Wir suchen Verstärkung.</h2></div>
  <div><p>Wir suchen Menschen, keine Lebensläufe. Quereinsteiger sind herzlich willkommen – ein kurzes Hallo genügt.</p>
  <p class="caps klein">Service · Küche · Bar · Greißlerei · Vinothek</p>
  <a class="knopf" href="{WA}" target="_blank" rel="noopener">Per WhatsApp melden</a></div></div></section>"""]
    return seite(v, "kontakt", "Reservieren & Kontakt · FERUN Alte Post Eggstätt", "Tisch reservieren, Kontakt und Jobs im FERUN Alte Post am Kirchplatz in Eggstätt.", "\n".join(teile))


def main():
    for v in ("klar", "salbei", "bogen", "linie"):
        out = os.path.join(HERE, v)
        os.makedirs(out, exist_ok=True)
        dateien = {"index": startseite(v), "karte": karte(v), "haus": haus(v), "kontakt": kontakt(v)}
        for s in B:
            dateien[s] = bereichsseite(v, s)
        for name, inhalt in dateien.items():
            open(os.path.join(out, name + ".html"), "w").write(inhalt)
        print(v, len(dateien), "Seiten")
    print("Bilder verwendet:", len(VERWENDET))


if __name__ == "__main__":
    main()
