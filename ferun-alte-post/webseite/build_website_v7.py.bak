#!/usr/bin/env python3
"""FERUN Alte Post – Webseite bauen, Version 2 (26.09.2026, nach Kunden-Feedback).
Kompakt und minimalistisch nach den Kunden-Referenzen (Buech: Wortbild auf Weiss, Text nie auf dem Bild;
Waltz: wenige Bloecke + "Tischerl"-Aufruf). Startseite = Hero + sechs Bereichs-Kacheln + Aufruf + Fuss.
Kein Teller, kein Bildwechsel unter Text. Zwei Designs: klar/ und salbei/, je 10 Seiten.
Texte nach Webseite/Texte/FERUN_Sprache_und_Texte.md (Ihr/Euch, keine Jahreszahl, nichts erfinden).
Jedes Bild ist ein editierbares Feld (assets/editor.js). Alte Fassung: build_website_v1.py.bak"""
import html as H
import json, os, time

HERE = os.path.dirname(os.path.abspath(__file__))
BIB = os.path.join(HERE, "assets", "bibliothek")
VER = time.strftime("%Y%m%d%H%M")
TEL, TEL_TXT, MAIL = "+491622308214", "+49 162 230 82 14", "holger.brunk@ferun.de"
WA = "https://wa.me/491622308214"

BEREICHE = [  # slug, Name, Spruch, Satz, Kachelbild (Bogen), Kopfbild (Bogen), Nr, was
    ("gasthaus", "Gasthaus", "Mahlzeit.", "Alpenländische Küche, ehrlich gekocht und schön angerichtet.", "WC_W41_9x16", "WG_W42_9x16", "I", "Stuben, Kaminstube und alpenländische Küche"),
    ("vinothek", "Vinothek", "Zum Wohl.", "Gute Weine und Zeit für eine gute Beratung.", "WG_W44_9x16", "R4C_N14_9x16", "II", "Weine, Beratung und Weinproben"),
    ("biergarten", "Biergarten", "Unter der Kastanie.", "Eine Brotzeit, a kühle Halbe und Schatten unter alten Bäumen.", "R1G_E07_getraenke", "R2C_E02_getraenke", "III", "Brotzeit und Bier unter Kastanien"),
    ("greisslerei", "Greißlerei", "Für daheim.", "Gutes aus der Region und Feines aus unserer Küche zum Mitnehmen.", "WC_W45_9x16", "WG_W45_9x16", "IV", "Regionales und Feines zum Mitnehmen"),
    ("bar", "Bar", "Auf ein Glaserl.", "Für den Aperitif vorm Essen und das letzte Glas des Abends.", "WC_W43_9x16", "R4G_M21_9x16", "V", "Aperitif und das letzte Glas des Abends"),
    ("festsaal", "Festsaal", "Feiern.", "Hochzeiten, Taufen, Geburtstage – ein Saal für die großen Tage.", "R2C_C04_raeume", "R2G_C04_raeume", "VI", "Hochzeiten, Taufen und Geburtstage"),
]
B = {b[0]: b for b in BEREICHE}
VERWENDET = set()


def f(name):
    if not os.path.exists(os.path.join(BIB, name + ".jpg")):
        raise SystemExit("Bild fehlt: " + name)
    VERWENDET.add(name)
    return "../assets/bibliothek/" + name + ".jpg"


def bild(slot, name, ar="4/5", cls="", alt="", lazy=True, fest=False, px=None):
    a = f' style="aspect-ratio:{ar}"' if ar else ""
    ld = ' loading="lazy"' if lazy else ' fetchpriority="high"'
    return (f'<figure class="bild{" " + cls if cls else ""}" data-edit="{slot}"{" data-fest" if fest else ""}{f' data-px="{px}"' if px is not None else ""}{a}><div class="par">'
            f'<img src="{f(name)}" alt="{H.escape(alt)}"{ld} decoding="async"></div></figure>')


# ---------------------------------------------------------------- Rahmen

def kopf(seite, v="klar"):
    if v == "linie":
        return kopf_linie(seite)
    cur = lambda s: ' aria-current="page"' if s == seite else ""
    nav = "".join(f'<a class="caps" href="{s}.html"{cur(s)}>{n}</a>' for s, n, *_ in BEREICHE)
    vm = "".join(f'<a href="{s}.html">{n}</a>' for s, n, *_ in BEREICHE)
    return f"""<header class="kopf"><div class="wrap">
  <a class="logo-link" href="index.html" aria-label="FERUN Alte Post – Startseite"><img src="../assets/logo/FERUN_04_Quer_Blatt_farbig.svg" alt="FERUN Alte Post"></a>
  <nav class="hauptnav" aria-label="Bereiche">{nav}</nav>
  <div class="nebennav"><a class="caps nav-text" href="karte.html"{cur("karte")}>Karte</a><a class="caps nav-text" href="haus.html"{cur("haus")}>Das Haus</a>
  <a class="caps reservieren" href="kontakt.html" data-res>Tisch reservieren</a>
  <button class="menue-knopf caps" type="button" aria-expanded="false" aria-controls="vollmenue">Menü</button></div>
</div></header>
<div class="vollmenue" id="vollmenue" aria-label="Menü"><button class="menue-zu caps" type="button">Schließen</button>
  <nav><a href="index.html">Startseite</a>{vm}<div class="unten"><a href="karte.html">Wochenkarte</a><a href="haus.html">Das Haus</a><a href="kontakt.html" data-res>Tisch reservieren</a><a href="tel:{TEL}">{TEL_TXT}</a></div></nav></div>"""


STEMPEL = """<a class="stempel" href="kontakt.html" data-res aria-label="Tisch reservieren">
  <svg viewBox="0 0 100 100" aria-hidden="true"><defs><path id="kreis" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0"/></defs>
  <text font-family="Montserrat, sans-serif" font-size="8.2" fill="currentColor"><textPath href="#kreis" textLength="236" lengthAdjust="spacing">TISCH RESERVIEREN · FERUN ALTE POST ·</textPath></text></svg>
  <img src="../assets/logo/FERUN_08_Signet_Blatt_kupfer.svg" alt=""></a>"""


def fuss(v):
    logo = "FERUN_01_Hoch_Blatt_Eggstaett_weiss" if v == "salbei" else "FERUN_01_Hoch_Blatt_Eggstaett_farbig"
    links = "".join(f'<li><a href="{s}.html">{n}</a></li>' for s, n, *_ in BEREICHE)
    return f"""<footer class="fuss"><div class="wrap">
  <div class="fuss-raster">
    <div><img class="fuss-logo" src="../assets/logo/{logo}.svg" alt="FERUN Alte Post Eggstätt"></div>
    <div><h4>Besuch</h4><ul><li>Kirchplatz 2</li><li>83125 Eggstätt</li><li>Öffnungszeiten folgen</li></ul></div>
    <div><h4>Kontakt</h4><ul><li><a href="tel:{TEL}">{TEL_TXT}</a></li><li><a href="mailto:{MAIL}">{MAIL}</a></li><li><a href="kontakt.html" data-res>Tisch reservieren</a></li><li><a href="kontakt.html#jobs">Jobs</a></li></ul></div>
    <div><h4>Bereiche</h4><ul><li><a href="index.html">Startseite</a></li>{links}</ul></div>
  </div>
  <div class="fuss-unten"><span>FERUN Alte Post · Alpenländische Küche am Kirchplatz</span><span>Impressum · Datenschutz</span></div>
</div></footer>"""


def seite(v, slug, titel, beschreibung, inhalt):
    schema = json.dumps({"@context": "https://schema.org", "@type": "Restaurant", "name": "FERUN Alte Post",
                         "servesCuisine": "Alpenländische Küche", "telephone": TEL_TXT, "email": MAIL,
                         "address": {"@type": "PostalAddress", "streetAddress": "Kirchplatz 2", "postalCode": "83125",
                                     "addressLocality": "Eggstätt", "addressCountry": "DE"}}, ensure_ascii=False)
    return f"""<!doctype html>
<html lang="de" class="theme-{"salbei" if v == "salbei" else "klar"} layout-{v if v in ("bogen", "linie") else "klar"}" data-variante="{v}" data-seite="{slug}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{H.escape(titel)}</title>
<meta name="description" content="{H.escape(beschreibung)}">
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Montserrat:wght@400;500;600&display=swap">
<link rel="stylesheet" href="../assets/site.css?v={VER}">
<link rel="stylesheet" href="../assets/editor.css?v={VER}">
<link rel="icon" href="../assets/logo/FERUN_08_Signet_Blatt_kupfer.svg">
<script type="application/ld+json">{schema}</script>
</head>
<body>
<a class="skip" href="#inhalt">Zum Inhalt</a>
{INTRO if slug == "index" else ""}
{kopf(slug, v)}
<main id="inhalt">
{inhalt}
</main>
{fuss(v)}
{STEMPEL}
<script src="../assets/bibliothek.js?v={VER}"></script>
<script src="../assets/medien-data.js" onerror="this.remove()"></script>
<script src="../assets/site.js?v={VER}"></script>
<script src="../assets/editor.js?v={VER}"></script>
</body>
</html>
"""


INTRO = """<div class="intro" id="intro" hidden aria-hidden="true"><video class="intro-blatt" src="../assets/blatt_zeichnen.mp4" muted playsinline preload="auto"></video>
<span class="caps intro-skip">Klicken zum Überspringen</span></div>
<script>try{if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&!sessionStorage.getItem('ferun_intro')&&!sessionStorage.getItem('ferun_bearbeiten')){document.getElementById('intro').hidden=false;document.documentElement.classList.add('mit-intro');}}catch(e){}</script>"""

# ---------------------------------------------------------------- Startseite

def aufruf():
    return f"""<section class="sektion aufruf linie-oben"><div class="wrap">
  <h2 class="fade">Damit auch ein Tischerl frei ist.</h2>
  <div class="fade d1" style="display:flex;justify-content:center;gap:14px 26px;flex-wrap:wrap;align-items:center">
    <a class="knopf voll" href="kontakt.html" data-res>Tisch reservieren</a><a class="mehr caps" href="karte.html">Zur Wochenkarte</a></div>
  <div class="zeile caps fade d2"><span>Kirchplatz 2 · 83125 Eggstätt</span><a href="tel:{TEL}" style="text-decoration:none">{TEL_TXT}</a><span>Öffnungszeiten folgen</span></div>
</div></section>"""


SCHATTEN = ('<div class="schatten" aria-hidden="true"><video src="../assets/schatten.mp4" poster="../assets/schatten_poster.jpg" '
            'muted autoplay loop playsinline preload="metadata"></video></div>')


def galerie(slot, eintraege, titel="Einblicke", sub="", bogen=True):
    """eintraege: (Bild, Format h|q|k, Bogen?, Bildtext). Antippen = gross (Lightbox)."""
    items = "".join(f'<a class="{fm}{" b" if (bo and bogen) else ""}" href="{f(nm)}">{bild(f"{slot}-{i}", nm, ar=None, alt=txt, fest=True)}</a>'
                    for i, (nm, fm, bo, txt) in enumerate(eintraege))
    return f"""<section class="sektion einblicke" aria-labelledby="{slot}-t"><div class="wrap">
  <div class="galerie-kopf"><h2 id="{slot}-t" class="fade">{titel}</h2><p class="fade d1">{sub}</p></div>
  <div class="galerie3">{items}</div></div></section>"""


def raeume():
    k = "".join(f"""<a class="raum fade d{i % 3}" href="{s}.html">{bild("raum-" + s, kb, ar=None, cls="bogen", alt=n, lazy=False)}
    <div class="schild"><h3>{n}</h3><span class="pfeil" aria-hidden="true"></span><span class="was">{was}</span></div></a>"""
                for i, (s, n, spr, _, kb, _k, nr, was) in enumerate(BEREICHE))
    return f"""<section class="sektion" aria-labelledby="r-titel"><div class="wrap">
  <div class="intro-zeile"><h2 id="r-titel" class="fade">Sechs Räume,<br>ein Haus.</h2>
  <p class="fade d1">Unter weißen Gewölben kocht das Gasthaus, im Keller-Rot wartet der Wein, draußen der Schatten der Kastanien. Jeder Raum hat seinen eigenen Charakter.</p></div>
  <div class="raeume">{k}</div></div></section>"""


EINBLICKE = [("WG_W42_9x16", "h", True, "Die Kaminstube"), ("R3C_C26_1x1", "k", False, "Rindertatar auf dem Hausteller"),
             ("R4C_N12_3x2", "q", False, "Ein runder Tisch für vier"),
             ("R3C_C34_4x5", "h", False, "Dekantieren in der Vinothek"), ("R3G_G24_4x5", "h", False, "Kaiserschmarrn"),
             ("R4G_M09_1x1", "k", False, "Terrazzo und Messing an der Bar"), ("R3G_G23_4x5", "h", True, "Honig aus der Greißlerei"),
             ("R3G_G20_16x9", "q", False, "Morgens in der Stube"), ("R3C_C38_4x5", "h", False, "Eindecken"), ("R3C_C35_1x1", "k", True, "Ein Espresso an der Bar")]


def startseite_bogen(v):
    haupt, detail = ("WG_W41_9x16", "R4G_M08_4x5") if v == "klar" else ("WC_W41_9x16", "R4G_M14_4x5")
    hero = f"""<section class="hero3" aria-label="Willkommen">{SCHATTEN}<div class="wrap raster">
  <div class="text">
    <h1>Ein Gasthaus am <em>Kirchplatz</em>.</h1>
    <p class="sub">Alpenländische Küche in einem alten, historischen Haus – mit Vinothek, Biergarten, Greißlerei, Bar und Festsaal.</p>
    <div class="aktionen"><a class="knopf voll" href="kontakt.html" data-res>Tisch reservieren</a><a class="mehr caps" href="karte.html">Wochenkarte</a></div>
  </div>
  <div class="collage">{bild("hero", haupt, ar=None, cls="bogen gross", alt="Gedeckter Tisch unter dem Gewölbe", lazy=False)}
    {bild("hero-detail", detail, ar=None, cls="bogen klein", alt="Detail aus dem Haus", lazy=False)}</div>
</div></section>"""
    return seite(v, "index", "FERUN Alte Post · Gasthaus am Kirchplatz in Eggstätt",
                 "FERUN Alte Post: ein neues Gasthaus am Kirchplatz in Eggstätt mit alpenländischer Küche, Vinothek, Biergarten, Greißlerei, Bar und Festsaal.",
                 hero + raeume() + galerie("einblicke", EINBLICKE, "Einblicke", "Ein paar Blicke ins Haus, auf den Tisch und hinter die Theke.") + aufruf())



