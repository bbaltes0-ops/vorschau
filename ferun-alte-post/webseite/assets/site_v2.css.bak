/* FERUN Alte Post – Webseite v2 (26.09.2026): kompakt, ruhig, Text nie auf bewegtem Bild.
   Zwei Designs: .theme-klar (Papierweiss) und .theme-salbei (Salbei praesent). */
:root{
  --papier:#F6F5F1; --weiss:#FFFFFF; --salbei:#C4CBC1; --salbei-hell:#DCE1D9; --salbei-tief:#6F7D6C;
  --navy:#1B3C4A; --navy-weich:#566C75; --kupfer:#AC845B; --rot:#824550;
  --ease:cubic-bezier(.4,0,.2,1); --ease-out:cubic-bezier(.22,.61,.36,1);
  --rand:clamp(20px,5vw,80px); --max:1320px; --kopf:74px;
  --grund:var(--papier); --flaeche:#ECEDE7; --text:var(--navy); --text-weich:var(--navy-weich);
  --akzent:var(--kupfer); --linie:rgba(27,60,74,.14); --kopf-grund:rgba(246,245,241,.95); --fuss-grund:var(--papier); --fuss-text:var(--navy);
  color-scheme:light;
}
.theme-salbei{--grund:var(--salbei-hell); --flaeche:var(--salbei); --linie:rgba(27,60,74,.18); --kopf-grund:rgba(196,203,193,.97);
  --fuss-grund:var(--salbei-tief); --fuss-text:var(--papier)}
*{box-sizing:border-box}
html,body{margin:0;background:var(--grund);color:var(--text);overflow-x:clip}
body{font:400 15.5px/1.7 "Montserrat",system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}
img,video{max-width:100%;display:block}
a{color:inherit}
:focus-visible{outline:2px solid var(--akzent);outline-offset:4px}
[hidden]{display:none!important}
.caps{font:500 11px/1.4 "Montserrat",system-ui,sans-serif;letter-spacing:.26em;text-transform:uppercase}
h1,h2,h3{font-family:"Cormorant Garamond",Georgia,"Times New Roman",serif;font-weight:400;letter-spacing:-.01em;text-wrap:balance;margin:0}
h1{font-size:clamp(40px,5.4vw,84px);line-height:1}
h2{font-size:clamp(30px,3.4vw,50px);line-height:1.06}
h3{font-size:clamp(22px,1.9vw,28px);line-height:1.15}
p{margin:0 0 1em;max-width:58ch}
.lead{font:400 clamp(20px,1.7vw,25px)/1.45 "Cormorant Garamond",Georgia,serif;max-width:40ch}
.klein{font-size:13px;color:var(--text-weich)}
.eyebrow{color:var(--akzent);display:block;margin-bottom:14px}
.wrap{width:min(var(--max),100%);margin:0 auto;padding-inline:var(--rand)}
.sektion{padding-block:clamp(56px,7vw,104px)}
.linie-oben{border-top:1px solid var(--linie)}
.skip{position:absolute;left:-9999px}

/* ---------- Kopfleiste ---------- */
.kopf{position:sticky;top:0;z-index:40;background:var(--kopf-grund);backdrop-filter:blur(8px);border-bottom:1px solid var(--linie);
  padding-top:env(safe-area-inset-top,0px)}
.kopf .wrap{display:flex;align-items:center;gap:24px;height:var(--kopf);max-width:none}
.logo-link{flex:none;display:block;width:clamp(116px,10vw,150px)}
.logo-link img{width:100%;height:auto}
.hauptnav{flex:1;display:flex;justify-content:center;gap:clamp(12px,1.7vw,28px)}
.hauptnav a,.nebennav a{text-decoration:none;position:relative;padding:8px 0;white-space:nowrap}
.hauptnav a::after,.nebennav a:not(.reservieren)::after{content:"";position:absolute;left:0;right:100%;bottom:2px;height:1px;background:var(--akzent);transition:right .45s var(--ease)}
.hauptnav a:hover::after,.hauptnav a[aria-current="page"]::after,.nebennav a:hover::after,.nebennav a[aria-current="page"]::after{right:0}
.nebennav{display:flex;align-items:center;gap:clamp(12px,1.5vw,24px)}
.reservieren{text-decoration:none;border:1px solid var(--navy);padding:11px 18px!important;transition:background-color .35s var(--ease),color .35s var(--ease)}
.reservieren:hover{background:var(--navy);color:var(--papier)}
.menue-knopf{display:none;background:none;border:0;color:inherit;cursor:pointer;padding:10px 0}

.vollmenue{position:fixed;inset:0;z-index:60;background:var(--grund);opacity:0;pointer-events:none;transition:opacity .4s var(--ease);overflow:auto}
.vollmenue.offen{opacity:1;pointer-events:auto}
.vollmenue nav{padding:calc(var(--kopf) + 20px) var(--rand) 40px;display:grid;gap:2px}
.vollmenue nav a{font:400 clamp(30px,6vw,46px)/1.25 "Cormorant Garamond",Georgia,serif;text-decoration:none}
.vollmenue nav a:hover{color:var(--akzent)}
.vollmenue .unten{margin-top:26px;display:grid;gap:6px}
.vollmenue .unten a{font:500 12px/1.6 "Montserrat",sans-serif;letter-spacing:.2em;text-transform:uppercase}
.menue-zu{position:absolute;top:calc(20px + env(safe-area-inset-top,0px));right:var(--rand);background:none;border:0;cursor:pointer;color:var(--text);padding:10px 0}

/* ---------- Bildrahmen (editierbar) ---------- */
.bild{position:relative;overflow:hidden;margin:0;background:var(--flaeche);aspect-ratio:4/5}
.bild .par{position:absolute;inset:0}
.bild img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:var(--px,50%) var(--py,50%);
  transform:scale(var(--s,1));transform-origin:var(--px,50%) var(--py,50%);transition:transform 1.2s var(--ease-out)}
a:hover .bild img,a:focus-visible .bild img{transform:scale(calc(var(--s,1) * 1.04))}
.js .fade{opacity:0;transform:translateY(16px);transition:opacity .9s var(--ease-out),transform .9s var(--ease-out)}
.js .fade.sichtbar{opacity:1;transform:none}
.js .fade.d1{transition-delay:.08s}.js .fade.d2{transition-delay:.16s}.js .fade.d3{transition-delay:.24s}.js .fade.d4{transition-delay:.32s}.js .fade.d5{transition-delay:.4s}

/* ---------- Hero Klar: Wortbild auf Papier, Bild darunter (wie Buech) ---------- */
.hero-klar{padding-top:clamp(26px,4vh,52px)}
.wortbild{display:flex;justify-content:space-between;align-items:flex-end;gap:24px 40px;flex-wrap:wrap}
.wortbild .marke{font:400 clamp(72px,16.5vw,250px)/.8 "Cormorant Garamond",Georgia,serif;letter-spacing:.06em;margin:0 0 0 -.04em;color:var(--navy)}
.wortbild .rechts{max-width:30ch;padding-bottom:clamp(6px,1.4vw,20px)}
.wortbild .rechts p{margin:0 0 16px;font:400 clamp(19px,1.6vw,24px)/1.4 "Cormorant Garamond",Georgia,serif}
.hero-klar .bild{aspect-ratio:21/9;margin-top:clamp(22px,3.4vh,40px);max-height:62vh;width:100%}
.hero-klar .bildzeile{display:flex;justify-content:space-between;gap:20px;margin-top:12px;color:var(--text-weich)}

/* ---------- Hero Salbei: Flaeche links, Bild rechts ---------- */
.hero-salbei{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);min-height:calc(100svh - var(--kopf));max-height:900px}
.hero-salbei .panel{background:var(--salbei);display:flex;flex-direction:column;justify-content:center;gap:clamp(18px,3vh,32px);padding:clamp(30px,5vh,64px) var(--rand)}
.hero-salbei h1{max-width:11ch}
.hero-salbei .bild{aspect-ratio:auto;height:100%;min-height:360px}
.hero-salbei .panel p{margin:0;font:400 clamp(18px,1.5vw,22px)/1.45 "Cormorant Garamond",Georgia,serif;max-width:32ch}

/* ---------- Bereiche als Kacheln ---------- */
.kopfzeile{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:clamp(24px,3vw,40px);flex-wrap:wrap}
.kopfzeile p{margin:0;color:var(--text-weich);max-width:44ch}
.kacheln{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(14px,2vw,28px)}
.kachel{text-decoration:none;display:block}
.kachel .bild{aspect-ratio:4/5}
.kachel .unter{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding-top:14px;border-bottom:1px solid var(--linie);padding-bottom:12px;transition:border-color .4s var(--ease)}
.kachel h3{transition:color .35s var(--ease)}
.kachel .spr{font:italic 400 17px/1.2 "Cormorant Garamond",Georgia,serif;color:var(--text-weich)}
.kachel:hover .unter{border-color:var(--akzent)}
.kachel:hover h3{color:var(--akzent)}

/* ---------- Tischerl-Aufruf ---------- */
.aufruf{text-align:center}
.aufruf h2{margin-bottom:22px}
.aufruf .zeile{display:flex;justify-content:center;gap:14px 30px;flex-wrap:wrap;margin-top:34px;color:var(--text-weich)}
.theme-salbei .aufruf{background:var(--salbei)}
.knopf{display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--navy);color:var(--navy);background:transparent;text-decoration:none;
  padding:15px 30px;font:500 11px/1 "Montserrat",sans-serif;letter-spacing:.26em;text-transform:uppercase;cursor:pointer;transition:background-color .35s var(--ease),color .35s var(--ease)}
.knopf:hover,.knopf:focus-visible{background:var(--navy);color:var(--papier)}
.knopf.voll{background:var(--navy);color:var(--papier)}
.knopf.voll:hover{background:var(--kupfer);border-color:var(--kupfer)}
.mehr{display:inline-flex;align-items:center;gap:12px;text-decoration:none;padding:6px 0}
.mehr::after{content:"";width:34px;height:1px;background:var(--akzent);transition:width .4s var(--ease)}
.mehr:hover::after{width:54px}

/* ---------- Unterseiten ---------- */
.seitenkopf{padding-top:clamp(34px,5vw,70px)}
.seitenkopf .titel{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px clamp(24px,5vw,80px);align-items:end;margin-bottom:clamp(24px,3.4vw,44px)}
.seitenkopf .titel p{margin:0}
.seitenkopf .bild{aspect-ratio:21/9;max-height:60vh;width:100%}
.theme-salbei .seitenkopf{background:linear-gradient(var(--salbei) 0 calc(100% - 22vh),var(--grund) 0)}
.inhalt2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(24px,5vw,80px);align-items:start}
.drei{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(12px,1.8vw,24px)}
.drei .bild{aspect-ratio:4/5}
.punkte{list-style:none;margin:22px 0 0;padding:0;border-top:1px solid var(--linie)}
.punkte li{display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid var(--linie)}
.punkte b{font:400 20px/1.3 "Cormorant Garamond",Georgia,serif}
.punkte span{color:var(--text-weich);font-size:13.5px;text-align:right}
.weiter{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;border-top:1px solid var(--linie);padding-block:clamp(30px,4vw,54px)}
.bereichswahl{display:flex;flex-wrap:wrap;gap:8px}
.bereichswahl a{text-decoration:none;border:1px solid var(--linie);padding:9px 15px;transition:border-color .3s,background-color .3s,color .3s}
.bereichswahl a:hover{border-color:var(--navy)}
.bereichswahl a[aria-current="page"]{background:var(--navy);color:var(--papier);border-color:var(--navy)}

/* Karte */
.kartennav{position:sticky;top:calc(var(--kopf) + env(safe-area-inset-top,0px));z-index:10;background:var(--kopf-grund);backdrop-filter:blur(8px);border-bottom:1px solid var(--linie)}
.kartennav .wrap{display:flex;gap:clamp(16px,3vw,40px);overflow-x:auto;padding-block:14px;scrollbar-width:none}
.kartennav a{text-decoration:none;white-space:nowrap}
.kartennav a.an{color:var(--akzent)}
.gaenge{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(30px,4vw,60px) clamp(30px,6vw,90px)}
.gang{scroll-margin-top:calc(var(--kopf) + 70px)}
.gang h2{font-size:clamp(28px,2.6vw,38px)}
.hinweis-box{border-left:2px solid var(--akzent);padding:2px 0 2px 16px;color:var(--text-weich);font-size:14px;max-width:60ch;margin:0}

/* Festsaal-Ablauf */
.ablauf{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(14px,2vw,28px);counter-reset:s}
.ablauf li{border-top:1px solid var(--akzent);padding-top:14px;counter-increment:s}
.ablauf li::before{content:counter(s,upper-roman);font:400 24px/1 "Cormorant Garamond",Georgia,serif;color:var(--akzent);display:block;margin-bottom:8px}
.ablauf p{margin:4px 0 0;color:var(--text-weich);font-size:14px}

/* Formulare */
.formular{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 24px}
.formular .voll{grid-column:1/-1}
.feld label{display:block;margin-bottom:4px;color:var(--text-weich)}
.feld input,.feld textarea,.feld select{width:100%;font:inherit;color:var(--text);background:transparent;border:0;border-bottom:1px solid var(--text-weich);padding:8px 0;border-radius:0}
.feld select{appearance:none}
.feld textarea{min-height:80px;resize:vertical}
.feld input:focus,.feld textarea:focus,.feld select:focus{outline:none;border-bottom-color:var(--akzent)}
.danke{border-left:2px solid var(--akzent);padding:4px 0 4px 14px;margin:0}
.info{display:grid;gap:26px}
.info h3{margin-bottom:6px}
.info p{margin:0;color:var(--text-weich)}
.info a{text-decoration:none;border-bottom:1px solid var(--linie)}

/* Stempel (nur Desktop) */
.stempel{position:fixed;right:clamp(16px,2.2vw,30px);bottom:clamp(16px,2.2vw,30px);z-index:35;width:96px;height:96px;border-radius:50%;display:grid;place-items:center;
  text-decoration:none;color:var(--navy);background:var(--papier);box-shadow:0 12px 30px -18px rgba(27,60,74,.5);transition:transform .4s var(--ease),opacity .4s}
.theme-salbei .stempel{background:var(--salbei)}
.stempel svg{position:absolute;inset:0;width:100%;height:100%;animation:drehen 18s linear infinite}
.stempel img{width:26px}
.stempel:hover{transform:scale(1.06)}
.stempel.weg{opacity:0;pointer-events:none}
@keyframes drehen{to{transform:rotate(360deg)}}

/* Fuss */
.fuss{background:var(--fuss-grund);color:var(--fuss-text);padding-block:clamp(44px,5vw,72px) 26px}
.theme-klar .fuss{border-top:1px solid var(--linie)}
.fuss-raster{display:grid;grid-template-columns:1fr auto auto auto;gap:clamp(22px,4vw,64px);align-items:start}
.fuss-logo{width:118px}
.fuss h4{font:500 11px/1.4 "Montserrat",sans-serif;letter-spacing:.26em;text-transform:uppercase;color:var(--akzent);margin:0 0 12px}
.theme-salbei .fuss h4{color:var(--papier);opacity:.72}
.fuss ul{list-style:none;margin:0;padding:0;display:grid;gap:4px;font-size:14px}
.fuss a{text-decoration:none}
.fuss a:hover{text-decoration:underline;text-underline-offset:4px}
.fuss-unten{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;border-top:1px solid color-mix(in srgb,currentColor 22%,transparent);margin-top:34px;padding-top:18px;font-size:12px;opacity:.8}

/* ---------- Responsive ---------- */
@media (max-width:1180px){
  .hauptnav,.nebennav .nav-text{display:none}
  .menue-knopf{display:inline-flex}
  .kopf .wrap{justify-content:space-between}
}
@media (max-width:980px){
  .hero-salbei{grid-template-columns:1fr;min-height:0;max-height:none}
  .hero-salbei .bild{height:auto;aspect-ratio:3/2;min-height:0}
  .seitenkopf .titel,.inhalt2{grid-template-columns:1fr}
  .theme-salbei .seitenkopf{background:linear-gradient(var(--salbei) 0 calc(100% - 14vh),var(--grund) 0)}
  .fuss-raster{grid-template-columns:1fr 1fr}
  .ablauf{grid-template-columns:1fr 1fr}
  .gaenge{grid-template-columns:1fr}
}
@media (max-width:760px){
  /* Kacheln seitlich wischen statt lange scrollen */
  .kacheln{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;margin-inline:calc(var(--rand) * -1);padding-inline:var(--rand);scroll-padding-inline:var(--rand);scrollbar-width:none;gap:14px}
  .kacheln::-webkit-scrollbar{display:none}
  .kachel{flex:0 0 72%;scroll-snap-align:start}
  .drei{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;margin-inline:calc(var(--rand) * -1);padding-inline:var(--rand);scroll-padding-inline:var(--rand);scrollbar-width:none}
  .drei .bild{flex:0 0 68%;scroll-snap-align:start}
  .hero-klar .bildzeile{display:none}
  .formular{grid-template-columns:1fr}
  .stempel{display:none}
  .kopf .reservieren{display:none}
}
@media (max-width:520px){
  .fuss-raster{grid-template-columns:1fr 1fr}
  .fuss-raster > div:first-child{grid-column:1/-1}
  .fuss-raster > div:last-child{display:none}
  .ablauf{grid-template-columns:1fr}
  .punkte li{flex-direction:column;gap:2px}
  .punkte span{text-align:left}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
  .js .fade{opacity:1;transform:none}
}
